{
  "tag": "RelativeLayout",
  "attrs": {
    "android:id": "rl_plate",
    "android:background": "#000000",
    "android:layout_width": "match_parent",
    "android:layout_height": "106dp"
  },
  "children": [
    {
      "tag": "LinearLayout",
      "attrs": {
        "android:gravity": "center",
        "android:orientation": "horizontal",
        "android:id": "ll_car_number",
        "android:layout_width": "105dp",
        "android:layout_height": "match_parent"
      },
      "children": [
        {
          "tag": "TextView",
          "attrs": {
            "android:textSize": "55dp",
            "android:textColor": "#ffe93e",
            "android:id": "tv_car_number",
            "android:layout_width": "wrap_content",
            "android:layout_height": "wrap_content",
            "android:maxLines": "1"
          },
          "children": []
        }
      ]
    },
    {
      "tag": "org.piaoyu.directionplatemaker.views.MarqueeTextView",
      "attrs": {
        "android:textSize": "39dp",
        "android:textColor": "#ffe93e",
        "android:gravity": "center_horizontal",
        "android:id": "tv_line_1",
        "android:layout_width": "match_parent",
        "android:layout_height": "wrap_content",
        "android:layout_marginTop": "13dp",
        "android:layout_toRightOf": "@+id/ll_car_number"
      },
      "children": []
    },
    {
      "tag": "org.piaoyu.directionplatemaker.views.MarqueeTextView",
      "attrs": {
        "android:textSize": "39dp",
        "android:textColor": "#ffe93e",
        "android:gravity": "center_horizontal",
        "android:id": "tv_line_2",
        "android:layout_width": "match_parent",
        "android:layout_height": "wrap_content",
        "android:layout_marginTop": "3dp",
        "android:layout_toRightOf": "@+id/ll_car_number",
        "android:layout_below": "@+id/tv_line_1"
      },
      "children": []
    }
  ]
}
